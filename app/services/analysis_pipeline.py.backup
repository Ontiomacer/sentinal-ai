import json
import asyncio
from typing import Optional, Dict, Any
from pathlib import Path
from sqlalchemy.ext.asyncio import AsyncSession

from app.services.evidence_service import EvidenceService
from app.services.timeline_service import TimelineService
from app.services.apk_analyzer import APKAnalyzer
from app.services.ai_cognition import AICognitionEngine
from app.services.entity_service import EntityService
from app.services.ghidra_service import get_ghidra_service, GhidraService
from app.models.case import EntityType


class AnalysisPipeline:
    """Orchestrates dual forensic analysis pipelines."""
    
    PIPELINE_NEURAL = "neural_ai"
    PIPELINE_DEEP = "deep_reverse_engineering"
    
    @staticmethod
    async def start_analysis(
        db: AsyncSession,
        evidence_id: str,
        case_id: str,
        user_id: str,
        pipeline_type: str
    ) -> Dict[str, Any]:
        """Start analysis pipeline for evidence."""
        
        # Get evidence
        evidence = await EvidenceService.get_evidence(db, evidence_id)
        if not evidence:
            raise ValueError("Evidence not found")
        
        # Update status to indexing
        await EvidenceService.update_analysis_status(db, evidence_id, 'indexing')
        
        # Create timeline event
        await TimelineService.create_auto_event(
            db=db,
            case_id=case_id,
            user_id=user_id,
            event_type='analysis',
            title=f'Analysis Started: {pipeline_type}',
            description=f'Initiating {pipeline_type} pipeline for {evidence.original_filename}',
            evidence_id=evidence_id,
            metadata={'pipeline': pipeline_type}
        )
        
        # Route to appropriate pipeline
        if pipeline_type == AnalysisPipeline.PIPELINE_NEURAL:
            result = await AnalysisPipeline._neural_ai_pipeline(db, evidence, case_id, user_id)
        elif pipeline_type == AnalysisPipeline.PIPELINE_DEEP:
            result = await AnalysisPipeline._deep_reverse_engineering_pipeline(db, evidence, case_id, user_id)
        else:
            raise ValueError(f"Unknown pipeline type: {pipeline_type}")
        
        return result
    
    @staticmethod
    async def _neural_ai_pipeline(
        db: AsyncSession,
        evidence: Any,
        case_id: str,
        user_id: str
    ) -> Dict[str, Any]:
        """
        Pipeline A: Neural AI Analysis
        - Fast behavioral analysis
        - APK heuristics
        - Risk scoring
        - AI threat cognition
        - Malware behavior detection
        """
        
        result = {
            'pipeline': 'neural_ai',
            'evidence_id': evidence.id,
            'stages': []
        }
        
        try:
            # Stage 1: Static Analysis
            await EvidenceService.update_analysis_status(db, evidence.id, 'static_analysis')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='Static Analysis: In Progress',
                evidence_id=evidence.id
            )
            
            # Perform APK analysis
            apk_data = await APKAnalyzer.analyze(Path(evidence.file_path))
            result['stages'].append({
                'stage': 'static_analysis',
                'status': 'complete',
                'data': apk_data
            })
            
            # Stage 2: AI Correlation
            await EvidenceService.update_analysis_status(db, evidence.id, 'ai_correlation')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='AI Cognition: Analyzing Behavior',
                evidence_id=evidence.id
            )
            
            # AI threat cognition
            ai_engine = AICognitionEngine()
            ai_analysis = {
                'risk_score': min(len(apk_data.get('permissions', [])) * 5, 100),
                'threat_level': 'high' if len(apk_data.get('permissions', [])) > 10 else 'medium',
                'suspicious_permissions': apk_data.get('permissions', [])[:10],
                'urls_found': len(apk_data.get('urls', [])),
                'domains_found': len(apk_data.get('domains', []))
            }
            result['stages'].append({
                'stage': 'ai_correlation',
                'status': 'complete',
                'data': ai_analysis
            })
            
            # Stage 3: Entity Extraction
            entities_extracted = await AnalysisPipeline._extract_entities(
                db, case_id, apk_data, ai_analysis
            )
            result['entities_extracted'] = entities_extracted
            
            # Stage 4: Report Ready
            await EvidenceService.update_analysis_status(
                db, 
                evidence.id, 
                'complete',
                {
                    'pipeline': 'neural_ai',
                    'apk_analysis': apk_data,
                    'ai_analysis': ai_analysis,
                    'risk_score': ai_analysis.get('risk_score', 0),
                    'threat_level': ai_analysis.get('threat_level', 'unknown')
                }
            )
            
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='finding',
                title=f'Neural AI Analysis Complete',
                description=f"Risk Score: {ai_analysis.get('risk_score', 0)}/100, Threat Level: {ai_analysis.get('threat_level', 'unknown')}",
                evidence_id=evidence.id,
                metadata={
                    'risk_score': ai_analysis.get('risk_score', 0),
                    'threat_level': ai_analysis.get('threat_level', 'unknown'),
                    'entities_found': entities_extracted
                }
            )
            
            result['status'] = 'complete'
            return result
            
        except Exception as e:
            await EvidenceService.update_analysis_status(db, evidence.id, 'failed')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='Analysis Failed',
                description=f'Error: {str(e)}',
                evidence_id=evidence.id
            )
            raise
    
    @staticmethod
    async def _deep_reverse_engineering_pipeline(
        db: AsyncSession,
        evidence: Any,
        case_id: str,
        user_id: str
    ) -> Dict[str, Any]:
        """
        Pipeline B: Deep Reverse Engineering
        - Ghidra MCP integration
        - JADX extraction
        - Decompiled code analysis
        - IOC extraction
        - Call graph analysis
        - Anti-analysis detection
        """
        
        result = {
            'pipeline': 'deep_reverse_engineering',
            'evidence_id': evidence.id,
            'stages': []
        }
        
        try:
            # Stage 1: Static Analysis
            await EvidenceService.update_analysis_status(db, evidence.id, 'static_analysis')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='Deep Analysis: Static Extraction',
                evidence_id=evidence.id
            )
            
            apk_data = await APKAnalyzer.analyze(Path(evidence.file_path))
            result['stages'].append({
                'stage': 'static_analysis',
                'status': 'complete',
                'data': apk_data
            })
            
            # Stage 2: Ghidra Analysis (if available)
            await EvidenceService.update_analysis_status(db, evidence.id, 'ghidra_analysis')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='Ghidra: Reverse Engineering',
                evidence_id=evidence.id
            )
            
            # Placeholder for Ghidra MCP integration
            ghidra_data = {
                'status': 'unavailable',
                'message': 'Ghidra MCP server not configured',
                'native_libraries': apk_data.get('native_libraries', [])
            }
            result['stages'].append({
                'stage': 'ghidra_analysis',
                'status': 'skipped',
                'data': ghidra_data
            })
            
            # Stage 3: AI Correlation
            await EvidenceService.update_analysis_status(db, evidence.id, 'ai_correlation')
            
            ai_engine = AICognitionEngine()
            ai_analysis = {
                'risk_score': min(len(apk_data.get('permissions', [])) * 5, 100),
                'threat_level': 'high' if len(apk_data.get('permissions', [])) > 10 else 'medium',
                'suspicious_permissions': apk_data.get('permissions', [])[:10],
                'urls_found': len(apk_data.get('urls', [])),
                'domains_found': len(apk_data.get('domains', []))
            }
            result['stages'].append({
                'stage': 'ai_correlation',
                'status': 'complete',
                'data': ai_analysis
            })
            
            # Stage 4: Entity Extraction
            entities_extracted = await AnalysisPipeline._extract_entities(
                db, case_id, apk_data, ai_analysis
            )
            result['entities_extracted'] = entities_extracted
            
            # Stage 5: Report Ready
            await EvidenceService.update_analysis_status(
                db,
                evidence.id,
                'complete',
                {
                    'pipeline': 'deep_reverse_engineering',
                    'apk_analysis': apk_data,
                    'ghidra_analysis': ghidra_data,
                    'ai_analysis': ai_analysis,
                    'risk_score': ai_analysis.get('risk_score', 0),
                    'threat_level': ai_analysis.get('threat_level', 'unknown')
                }
            )
            
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='finding',
                title='Deep Reverse Engineering Complete',
                description=f"Comprehensive analysis finished. Risk Score: {ai_analysis.get('risk_score', 0)}/100",
                evidence_id=evidence.id,
                metadata={
                    'risk_score': ai_analysis.get('risk_score', 0),
                    'threat_level': ai_analysis.get('threat_level', 'unknown'),
                    'entities_found': entities_extracted,
                    'ghidra_available': False
                }
            )
            
            result['status'] = 'complete'
            return result
            
        except Exception as e:
            await EvidenceService.update_analysis_status(db, evidence.id, 'failed')
            await TimelineService.create_auto_event(
                db=db,
                case_id=case_id,
                user_id=user_id,
                event_type='analysis',
                title='Deep Analysis Failed',
                description=f'Error: {str(e)}',
                evidence_id=evidence.id
            )
            raise
    
    @staticmethod
    async def _extract_entities(
        db: AsyncSession,
        case_id: str,
        apk_data: Dict[str, Any],
        ai_analysis: Dict[str, Any]
    ) -> int:
        """Extract and create entities from analysis results."""
        
        entities_created = 0
        
        # Extract URLs
        urls = apk_data.get('urls', [])
        for url in urls[:10]:  # Limit to top 10
            try:
                from app.schemas.case import EntityCreate
                entity_data = EntityCreate(
                    entity_type=EntityType.URL,
                    name=f"URL: {url[:50]}",
                    value=url,
                    description="Extracted from APK analysis",
                    risk_score=ai_analysis.get('risk_score', 50),
                    tags=['auto-extracted', 'url'],
                    related_evidence=[],
                    metadata={'source': 'apk_analysis'}
                )
                await EntityService.create_entity(db, case_id, entity_data)
                entities_created += 1
            except:
                pass
        
        # Extract domains
        domains = apk_data.get('domains', [])
        for domain in domains[:10]:
            try:
                from app.schemas.case import EntityCreate
                entity_data = EntityCreate(
                    entity_type=EntityType.DOMAIN,
                    name=f"Domain: {domain}",
                    value=domain,
                    description="Extracted from APK analysis",
                    risk_score=ai_analysis.get('risk_score', 50),
                    tags=['auto-extracted', 'domain'],
                    related_evidence=[],
                    metadata={'source': 'apk_analysis'}
                )
                await EntityService.create_entity(db, case_id, entity_data)
                entities_created += 1
            except:
                pass
        
        return entities_created
